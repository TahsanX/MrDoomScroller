<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating counter. Ellie's head sits beside the number so the pill is
  recognisably this app at a glance, without a label eating width: it covers part of
  someone else's feed, so it stays as small as it can.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:background="@drawable/sw_overlay_pill"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="8dp"
  android:paddingTop="6dp"
  android:paddingEnd="14dp"
  android:paddingBottom="6dp">

  <ImageView
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:contentDescription="@string/sw_service_label"
    android:src="@drawable/sw_ellie_mark" />

  <TextView
    android:id="@+id/sw_overlay_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:fontFamily="sans-serif-medium"
    android:text="0"
    android:textColor="#F0EFEC"
    android:textSize="18sp" />
</LinearLayout>
